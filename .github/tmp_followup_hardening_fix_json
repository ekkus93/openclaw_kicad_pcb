#!/usr/bin/env python3
from pathlib import Path

path = Path("tests/web/test_web_llm_clients.py")
text = path.read_text(encoding="utf-8")
old = "import contextlib\nimport os\n"
new = "import contextlib\nimport json\nimport os\n"
count = text.count(old)
if count != 1:
    raise RuntimeError(f"expected exactly one import insertion point, found {count}")
path.write_text(text.replace(old, new, 1), encoding="utf-8")
